# Supabase 프로젝트 설정 > API 메뉴에서 값을 복사해서 .env.local 파일을 만드세요.
# (이 파일 자체는 예시일 뿐이며, 실제 값은 .env.local 에 넣고 git에는 올리지 않습니다.)

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# AI 문제 유형 분석(/analyze)용 Claude API 키. 서버에서만 쓰이므로 NEXT_PUBLIC_ 을 붙이지 않는다.
# https://platform.claude.com 에서 발급. Vercel에는 Settings > Environment Variables에 같은 이름으로 넣는다.
ANTHROPIC_API_KEY=YOUR-ANTHROPIC-API-KEY
